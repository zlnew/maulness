# ==============================================================================
# Maulness Personal Agent Harness — Environment Configuration
# ==============================================================================
# Save this file to ~/.config/maulness/.env (or ~/.config/maulness/env)
# Individual profiles can override variables in ~/.config/maulness/profiles/<name>/.env

# ── Workspace Paths ────────────────────────────────────────────────────────────
# Root directory where personal projects and repositories live
WORKSPACE_ROOT=/home/zlnew/www/personal

# ── Discord Bot Gateway & Notifications (Optional) ─────────────────────────────
# Required if running the background Discord bot listener and Forum channel sync
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
OWNER_DISCORD_ID=

# ── Antigravity Engine (ACP / Subprocess) ───────────────────────────────────────
# Default command to spawn the local Antigravity CLI binary
AGY_CMD=agy

# Optional path override if using a custom localharness binary
# ANTIGRAVITY_HARNESS_PATH=/path/to/custom/localharness

# ── AI Model Provider Keys ─────────────────────────────────────────────────────
# Google Gemini API Key (Google AI Studio)
GEMINI_API_KEY=

# Anthropic Claude API Key (for direct Anthropic API calls)
ANTHROPIC_API_KEY=

# OpenAI API Key (for direct OpenAI API calls)
OPENAI_API_KEY=

# OpenRouter API Key (for unified multi-model routing)
OPENROUTER_API_KEY=

# ── Google Cloud / Vertex AI (Optional for Enterprise / Project ID) ────────────
# Used when profiles configure vertex: true or provider: antigravity_sdk with GCP
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_GENAI_USE_VERTEXAI=true

# ── Harness Runtime Options ────────────────────────────────────────────────────
# Custom SQLite database location (defaults to ~/.config/maulness/maulness.db)
# MAULNESS_DB_PATH=
