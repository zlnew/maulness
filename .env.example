# Maulness Environment Configuration
# Save this file to ~/.config/maulness/env or repo/maulness/.env

# Workspace Paths
WORKSPACE_ROOT=/home/zlnew/www/personal

# Discord Gateway (Required for Discord integration)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_FORUM_CHANNEL_ID=
OWNER_DISCORD_ID=

# Gemini API (For fast conversational triage)
GEMINI_API_KEY=

# Antigravity ACP Binary Command (defaults to "agy --acp")
AGY_CMD=agy --acp
